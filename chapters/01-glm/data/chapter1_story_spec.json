  "implementation_notes": {
    "frontend_not_included": true,
    "plot_library": "Plotly",
    "data_loading": "static JSON fetch",
    "format_rules": {
      "eur_2": "2 decimal places with € suffix",
      "eur_0": "whole euros with € suffix",
      "rate_4dp": "4 decimal places"
    }
  }
